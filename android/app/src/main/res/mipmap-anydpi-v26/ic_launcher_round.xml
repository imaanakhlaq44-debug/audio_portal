<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: the launcher crops this to the device's shape (circle,
     squircle...). The foreground is the full Qissora logo at 108dp; its
     Q + headphones sit inside the 72dp safe zone. -->
