migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing material - NEVER commit these.
# build.gradle.kts reads android/key.properties and falls back to the debug
# key when it is absent, so local clones still build without them.
key.properties
**/key.properties
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision

# Local tooling
.vscode/launch.json

# Raw narration masters. Several GB of mp3/wav per language, and the app only
# ever ships the cut, re-encoded episodes under assets/audio/.
/Story x URDU/
/StoryxEnglish/
*.plan.json

# Cut episode audio (~170 MB). It is streamed from audio.qissora.app, where
# tools/upload_audio.ps1 put it, and tools/gen_series.dart --cut rebuilds it
# from the narration masters.
/assets/audio/

# Brand fonts for tools/make_feature_graphic.mjs. Hey Haters is licensed and
# must not be committed; Plus Jakarta Sans is fetched per the note in that
# script. Both are found through the fontconfig it writes.
/tools/fonts/
